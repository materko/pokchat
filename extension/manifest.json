{
  "manifest_version": 3,
  "name": "Pokec Sklo Filter",
  "version": "0.4.0",
  "description": "Filter správ na pokec skle podľa mesta, pohlavia, mena a textu + automatické načítanie starších správ.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": [
        "https://pokec-sklo.azet.sk/miestnost/*",
        "http://pokec-sklo.azet.sk/miestnost/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": { "id": "pokec-sklo-filter@pokchat" }
  }
}
